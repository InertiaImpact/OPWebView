diff --git a/openpilot/system/webrtc/webrtcd.py b/openpilot/system/webrtc/webrtcd.py
--- a/openpilot/system/webrtc/webrtcd.py
+++ b/openpilot/system/webrtc/webrtcd.py
@@ -608,6 +608,13 @@ class WebrtcdHandler(BaseHTTPRequestHandler):
   def _send(self, status: int, body: bytes, content_type: str) -> None:
     self.send_response(status)
     self.send_header("Content-Type", content_type)
+    # Permit an installed or hosted OP WebView page to negotiate WebRTC with
