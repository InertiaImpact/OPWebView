{
  "name": "OP WebView",
  "short_name": "OP WebView",
  "description": "Local-first openpilot camera streaming and telemetry overlay.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "landscape",
  "background_color": "#020609",
  "theme_color": "#06131d",
  "icons": [
    { "src": "./icons/web-wheel-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/web-wheel-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ]
}
